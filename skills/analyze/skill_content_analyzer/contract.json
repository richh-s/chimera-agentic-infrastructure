{
  "skill_name": "skill_content_analyzer",
  "version": "1.1.0",
  "description": "Analyzes structured text to extract topics, themes, entities, sentiment, and confidence signals.",
  "inputs": {
    "text": {
      "type": "string",
      "required": true,
      "min_length": 10,
      "max_length": 20000,
      "example": "The future of autonomous AI systems depends on governance.",
      "description": "Plain text content to be analyzed."
    },
    "language": {
      "type": "string",
      "required": false,
      "validation": "regex",
      "pattern": "^[a-z]{2}$",
      "example": "en",
      "description": "ISO-639-1 language code. Auto-detected if omitted."
    },
    "analysis_depth": {
      "type": "string",
      "required": false,
      "validation": "enum",
      "allowed_values": ["basic", "standard", "deep"],
      "default": "standard",
      "description": "Controls analysis fidelity and cost."
    }
  },
  "outputs": {
    "topics": {
      "type": "array",
      "description": "High-level subject categories with confidence and relevance.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "relevance_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    },
    "themes": {
      "type": "array",
      "description": "Narrative or abstract themes.",
      "items": {
        "type": "object",
        "properties": {
          "theme": { "type": "string" },
          "description": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    },
    "entities": {
      "type": "array",
      "description": "Named entities with type and frequency.",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["PERSON", "ORG", "LOCATION", "PRODUCT", "EVENT", "OTHER"]
          },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "sentiment": {
      "type": "object",
      "description": "Detailed sentiment breakdown.",
      "properties": {
        "overall": {
          "type": "string",
          "enum": ["positive", "neutral", "negative"]
        },
        "score": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
        "breakdown": {
          "type": "object",
          "properties": {
            "positive": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "neutral": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "negative": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "key_emotional_signals": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "analysis_metadata": {
      "type": "object",
      "description": "Metadata about the analysis process.",
      "properties": {
        "processing_time_ms": { "type": "integer" },
        "model_version": { "type": "string" },
        "language_detected": { "type": "string" },
        "text_hash": { "type": "string" },
        "word_count": { "type": "integer" },
        "sentence_count": { "type": "integer" }
      }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Overall confidence of the analysis."
    }
  },
  "constraints": {
    "max_execution_time": 30,
    "rate_limit": "20/min",
    "max_text_length_chars": 20000,
    "min_confidence_threshold": 0.6,
    "supported_languages": ["en", "es", "fr", "de", "it", "pt", "ru", "zh"],
    "analysis_depth_costs": {
      "basic": "low",
      "standard": "medium",
      "deep": "high"
    },
    "resource_limits": {
      "memory_mb": 512,
      "cpu_cores": 1,
      "gpu_memory_mb": 0
    }
  },
  "security": {
    "requires_auth": false,
    "data_classification": "internal",
    "privacy_preserving": true
  }
}