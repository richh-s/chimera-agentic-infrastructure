{
  "skill_name": "skill_trend_classifier",
  "version": "1.2.0",
  "description": "Classifies analyzed content into trend categories, stages, and momentum indicators using pattern recognition.",
  "inputs": {
    "topics": {
      "type": "array",
      "required": true,
      "description": "Topics extracted from content analysis.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "AI Governance"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "example": 0.85
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "example": 0.72
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "required": true,
      "description": "Narrative or abstract themes from content analysis.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "example": "Ethical Technology"
          },
          "description": {
            "type": "string",
            "example": "Focus on responsible AI development"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "example": 0.78
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "required": false,
      "description": "Named entities associated with the content.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "OpenAI"
          },
          "type": {
            "type": "string",
            "enum": ["PERSON", "ORG", "LOCATION", "PRODUCT", "EVENT", "OTHER"]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "example": 3
          }
        }
      }
    },
    "time_context": {
      "type": "string",
      "required": false,
      "enum": ["real_time", "recent", "historical"],
      "default": "recent",
      "description": "Temporal context for trend evaluation."
    },
    "historical_context": {
      "type": "object",
      "required": false,
      "description": "Optional historical trend data for comparison.",
      "properties": {
        "previous_trend_category": {
          "type": "string",
          "enum": ["emerging", "stable", "declining"]
        },
        "previous_velocity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "days_since_last_observation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "domain_context": {
      "type": "string",
      "required": false,
      "enum": ["technology", "business", "culture", "politics", "generic"],
      "default": "generic",
      "description": "Domain context for trend relevance scoring."
    }
  },
  "outputs": {
    "trend_category": {
      "type": "string",
      "enum": ["emerging", "stable", "declining"],
      "description": "Overall trend classification based on momentum signals."
    },
    "trend_stage": {
      "type": "string",
      "enum": ["early", "growth", "peak", "saturation", "decline"],
      "description": "Lifecycle stage of the trend (based on adoption curve)."
    },
    "trend_velocity": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Momentum of the trend (0=stagnant, 1=accelerating rapidly)."
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Relevance of the trend to Chimera's domains (0=irrelevant, 1=core focus)."
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in trend classification (0=guessing, 1=certain)."
    },
    "supporting_signals": {
      "type": "object",
      "description": "Quantitative signals used to support trend decision.",
      "properties": {
        "topic_alignment": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "How well topics align with known trend patterns"
        },
        "theme_consistency": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Consistency of themes across content samples"
        },
        "entity_density": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Density of relevant entities in content"
        },
        "novelty_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Novelty/innovation level of content"
        },
        "sentiment_trend": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0,
          "description": "Sentiment trend direction (-1=negative, 1=positive)"
        }
      }
    },
    "trend_metadata": {
      "type": "object",
      "description": "Metadata about the trend classification process.",
      "properties": {
        "processing_time_ms": {
          "type": "integer"
        },
        "model_version": {
          "type": "string"
        },
        "input_signals_count": {
          "type": "integer"
        },
        "classification_method": {
          "type": "string",
          "enum": ["rule_based", "ml_classifier", "hybrid"]
        },
        "trend_taxonomy_version": {
          "type": "string"
        },
        "baseline_comparison": {
          "type": "boolean",
          "description": "Whether historical baseline was used"
        }
      }
    },
    "recommended_action": {
      "type": "string",
      "enum": ["prioritize", "monitor", "deprioritize"],
      "description": "Non-authoritative recommendation for downstream planning."
    }
  },
  "constraints": {
    "max_execution_time": 20,
    "rate_limit": "30/min",
    "min_confidence_threshold": 0.6,
    "min_input_signals": 2,
    "max_topics_considered": 10,
    "max_themes_considered": 5,
    "supported_time_contexts": ["real_time", "recent", "historical"],
    "trend_velocity_calculation_window": "7d",
    "resource_limits": {
      "memory_mb": 256,
      "cpu_cores": 1,
      "cache_mb": 100
    }
  },
  "error_handling": {
    "partial_results_allowed": false,
    "max_retries": 0,
    "fallback_strategy": "return_low_confidence",
    "insufficient_data_handling": "return_neutral",
    "confidence_thresholds": {
      "high": 0.8,
      "medium": 0.6,
      "low": 0.4
    },
    "recovery_strategies": [
      "simplify_classification",
      "use_domain_defaults",
      "escalate_to_judge"
    ]
  },
  "trend_patterns": {
    "description": "Pre-defined trend patterns used for classification.",
    "emerging_patterns": [
      "novel_topic_high_novelty",
      "accelerating_mentions",
      "diverse_source_adoption",
      "early_adopter_focus"
    ],
    "stable_patterns": [
      "consistent_volume",
      "established_entities",
      "predictable_cycles",
      "mainstream_coverage"
    ],
    "declining_patterns": [
      "decreasing_velocity",
      "saturation_signals",
      "negative_sentiment_shift",
      "legacy_entity_dominance"
    ]
  },
  "security": {
    "requires_auth": false,
    "data_classification": "internal",
    "privacy_preserving": true,
    "no_external_lookups": true,
    "trend_data_retention": "30d"
  }
}